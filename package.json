{
  "name": "plurk-hitokoto",
  "version": "1.0.0",
  "description": "Post quotes from hitokoto to plurk",
  "homepage": "https://github.com/soruly/plurk-hitokoto#readme",
  "bugs": {
    "url": "https://github.com/soruly/plurk-hitokoto/issues"
  },
  "license": "MIT",
  "author": "soruly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soruly/plurk-hitokoto.git"
  },
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "auth": "node auth.ts",
    "start": "node index.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "oxfmt": "oxfmt",
    "format": "oxfmt --write \"**/*.*\"",
    "lint": "oxfmt --check \"**/*.*\"",
    "test": "oxfmt --check \"**/*.*\""
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  }
